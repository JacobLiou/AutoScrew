<Window x:Class="AutoScrew.TemplateBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoScrew.TemplateBoard.ViewModels"
        xmlns:views="clr-namespace:AutoScrew.TemplateBoard.Views"
        mc:Ignorable="d"
        Title="螺钉位模板画板 — AutoScrew.TemplateBoard"
        Width="960"
        Height="720"
        MinWidth="640"
        MinHeight="480">
    <Window.InputBindings>
        <KeyBinding Key="A"
                    Modifiers="Control"
                    Command="{Binding SelectAllMarkersCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <TextBlock VerticalAlignment="Center" Text="宽" Margin="0,0,4,0" />
                <TextBox Width="72" Text="{Binding BoardWidthInput, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock VerticalAlignment="Center" Text="高" Margin="8,0,4,0" />
                <TextBox Width="72" Text="{Binding BoardHeightInput, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="应用尺寸" Command="{Binding ApplyBoardSizeCommand}" Margin="8,0,0,0" />
                <Separator />
                <Button Content="加载产品底图" Command="{Binding LoadProductImageCommand}" />
                <Button Content="画板=底图像素" Command="{Binding MatchBoardToImageSizeCommand}" ToolTip="将画板宽高设为底图像素尺寸，使标注与图片 1:1 对齐" />
                <Button Content="清除底图" Command="{Binding ClearProductImageCommand}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11" Text="底图透明度" />
                <Slider Width="120"
                        VerticalAlignment="Center"
                        Minimum="0.2"
                        Maximum="1"
                        SmallChange="0.05"
                        LargeChange="0.1"
                        Value="{Binding BoardImageOpacity, Mode=TwoWay}"
                        IsEnabled="{Binding HasBoardImage}" />
                <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" Width="40" FontSize="11"
                           Text="{Binding BoardImageOpacity, StringFormat={}{0:P0}}" />
                <Separator />
                <Button Content="保存 JSON" Command="{Binding SaveTemplateCommand}" />
                <Button Content="打开 JSON" Command="{Binding OpenTemplateCommand}" />
                <Button Content="全选" Command="{Binding SelectAllMarkersCommand}" />
                <Button Content="删除选中" Command="{Binding DeleteSelectedCommand}" />
                <Button Content="取消选中" Command="{Binding ClearSelectionCommand}" />
                <Separator />
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#FF475569"
                           Text="底图铺满画板 · 建议先「画板=底图像素」再打点 · Ctrl+单击多选" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Foreground="DarkRed" Text="{Binding OutOfBoundsWarning}" />
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="8">
            <Border BorderBrush="#FFCBD5E1" BorderThickness="1" Background="#FFF8FAFC">
                <Canvas x:Name="BoardCanvas"
                        Width="{Binding BoardWidth}"
                        Height="{Binding BoardHeight}"
                        ClipToBounds="True"
                        Background="#FFE5E7EB"
                        PreviewMouseLeftButtonDown="BoardCanvas_OnPreviewMouseLeftButtonDown">
                    <Image Panel.ZIndex="0"
                           Width="{Binding BoardWidth}"
                           Height="{Binding BoardHeight}"
                           Stretch="Fill"
                           Source="{Binding BoardImageSource}"
                           Opacity="{Binding BoardImageOpacity}"
                           IsHitTestVisible="False" />
                    <ItemsControl Panel.ZIndex="1"
                                  ItemsSource="{Binding Markers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ScrewMarkerViewModel}">
                                <views:ScrewMarkerView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
