{
  "Authentication": {
    "Mode": "Development",
    "Accounts": []
  },
  "AutoScrew": {
    "UseMockMes": false,
    "UseSimulatedHardware": false,
    "MesBaseUrl": "https://mes.example.invalid/",
    "DataDirectory": "",
    "TemplateDirectory": "",
    "OptionalNetworkArchiveRoot": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/autoscrew-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
