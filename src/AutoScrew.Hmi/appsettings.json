{
  "Authentication": {
    "Mode": "Development",
    "Accounts": [],
    "Mims": {
      "ConnectionString": "",
      "CommandTimeoutSeconds": 15,
      "UnmappedRoleBehavior": "Operator",
      "RoleMap": {
        "0": "Operator",
        "1": "Technician",
        "2": "Technician",
        "3": "Technician",
        "4": "Technician",
        "5": "Administrator",
        "6": "Administrator",
        "255": "Administrator"
      }
    }
  },
  "AutoScrew": {
    "UseMockMes": false,
    "UseSimulatedHardware": false,
    "MesBaseUrl": "https://mes.example.invalid/",
    "DataDirectory": "",
    "TemplateDirectory": "",
    "OptionalNetworkArchiveRoot": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/autoscrew-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
