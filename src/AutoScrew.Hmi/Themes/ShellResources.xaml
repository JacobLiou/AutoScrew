    <Style x:Key="HeaderIconCircleButton" TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="#FFF7F8FA"/>
        <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#FF64748B"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="hc:BorderElement.CornerRadius" Value="18"/>
        <Setter Property="hc:IconElement.Width" Value="16"/>
        <Setter Property="hc:IconElement.Height" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFEEF2F6"/>
                <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
