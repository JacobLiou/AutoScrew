<Application x:Class="AutoScrew.Hmi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:domain="clr-namespace:AutoScrew.Domain.Models;assembly=AutoScrew.Domain">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Themes/Strings.zh-CN.xaml" />
                <ResourceDictionary Source="/Themes/WpfUiShellResources.xaml" />
                <ResourceDictionary Source="/Themes/ShellResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="BrushPending" Color="#FFD54F"/>
            <SolidColorBrush x:Key="BrushPendingWaiting" Color="#FFF59D"/>
            <SolidColorBrush x:Key="BrushInProgress" Color="#FFC107"/>
            <SolidColorBrush x:Key="BrushOk" Color="#43A047"/>
            <SolidColorBrush x:Key="BrushNg" Color="#E53935"/>
            <Style x:Key="ScrewMarkerStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="#333333"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="Width" Value="{Binding DiameterPx}"/>
                <Setter Property="Height" Value="{Binding DiameterPx}"/>
                <Setter Property="Fill" Value="{StaticResource BrushPendingWaiting}"/>
                <Setter Property="Opacity" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static domain:StationScrewState.Ng}">
                        <Setter Property="Fill" Value="{StaticResource BrushNg}"/>
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static domain:StationScrewState.Ok}">
                        <Setter Property="Fill" Value="{StaticResource BrushOk}"/>
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static domain:StationScrewState.InProgress}">
                        <Setter Property="Fill" Value="{StaticResource BrushInProgress}"/>
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsNextTarget}" Value="True"/>
                            <Condition Binding="{Binding State}" Value="{x:Static domain:StationScrewState.Pending}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Fill" Value="{StaticResource BrushPending}"/>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard Name="NextTargetBlinkStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.35" Duration="0:0:0.5" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="NextTargetBlinkStoryboard"/>
                        </MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static domain:StationScrewState.Pending}">
                        <Setter Property="Fill" Value="{StaticResource BrushPendingWaiting}"/>
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
