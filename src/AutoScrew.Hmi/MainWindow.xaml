<Window x:Class="AutoScrew.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:AutoScrew.Hmi.Converters"
        xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
        xmlns:views="clr-namespace:AutoScrew.Hmi.Views"
        mc:Ignorable="d"
        Title="AutoScrew 智能锁附系统"
        Height="780"
        Width="1280"
        MinHeight="640"
        MinWidth="960"
        Background="#FFF0F2F5"
        d:DataContext="{d:DesignInstance vm:MainShellViewModel, IsDesignTimeCreatable=False}"
        Name="RootWindow">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanToGridLengthConverter x:Key="SidebarWidthConverter"
                                           ExpandedWidth="232" />
        <Style x:Key="SidebarBreadcrumbButton"
               TargetType="Button"
               BasedOn="{StaticResource ButtonCustom}">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="6,8" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="hc:BorderElement.CornerRadius"
                    Value="8" />
        </Style>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:OperationPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TemplateBoardViewModel}">
            <views:TemplateBoardView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 侧栏：宽度随 IsSidebarVisible 动画折叠/展开（面包屑 ToggleSidebarCommand） -->
        <Border x:Name="SidebarHost"
                Grid.Column="0"
                Width="253"
                ClipToBounds="True"
                HorizontalAlignment="Left"
                Background="#FFF7F8FA"
                BorderBrush="#FFE5E7EB"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarVisible}"
                                     Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="0"
                                                         Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSidebarVisible}"
                                     Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="253"
                                                         Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         BeginTime="0:0:0.06"
                                                         Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="20,12,20,12"
                        BorderBrush="#FFE5E7EB"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Image Stretch="Fill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="pack://application:,,,/Assets/logo_new.png"
                               Height="28"
                               Width="100" />
                        <TextBlock Text="智能锁附"
                                   FontSize="20"
                                   Margin="5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#FF111827" />
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom"
                           Text="v1.0.0"
                           Foreground="#FF94A3B8"
                           FontSize="11"
                           Margin="16,8" />
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="导航"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#FF94A3B8"
                               Margin="20,0,16,8" />
                    <hc:SideMenu ExpandMode="Freedom">
                        <hc:SideMenuItem Header="作业台"
                                         Icon="{StaticResource GeoNavOperation}"
                                         Command="{Binding NavigateOperationCommand}"
                                         IsSelected="{Binding IsOperationNavSelected, Mode=OneWay}" />
                        <hc:SideMenuItem Header="螺钉模板"
                                         Icon="{StaticResource GeoNavTemplate}"
                                         Command="{Binding NavigateTemplateCommand}"
                                         Visibility="{Binding CanUseTemplateBoard, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         IsSelected="{Binding IsTemplateNavSelected, Mode=OneWay}" />
                    </hc:SideMenu>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 主内容 -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top"
                    Background="White"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleHint}"
                            Style="{StaticResource SidebarBreadcrumbButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SidebarChromeIcon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#FF64748B"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Breadcrumb}"
                                       Margin="10,0,0,0"
                                       Foreground="#FF64748B"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Margin="3"
                                Content="记事本"
                                hc:BorderElement.CornerRadius="0"
                                ToolTip="记事本"
                                Background="{DynamicResource SecondaryTextBrush}"
                                Foreground="{DynamicResource TextIconBrush}"
                                Command="{Binding OpenNotepadCommand}"></Button>
                        <Button Margin="3"
                                Content="计算器"
                                hc:BorderElement.CornerRadius="0"
                                ToolTip="计算器"
                                Background="{DynamicResource SecondaryTextBrush}"
                                Foreground="{DynamicResource TextIconBrush}"
                                Command="{Binding OpenCalcCommand}"></Button>
                        <Border Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="#FF22C55E"
                                Margin="20,0,10,0">
                            <TextBlock Text="{Binding UserInitial}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UserGreeting}"
                                           FontWeight="SemiBold"
                                           Foreground="#FF111827" />
                                <TextBlock Text="{Binding UserRoleDisplay}"
                                           Margin="8,0,0,0"
                                           FontSize="12"
                                           Foreground="#FF64748B"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="已登录"
                                       FontSize="11"
                                       Foreground="#FF64748B" />
                        </StackPanel>
                        <Button Style="{StaticResource HeaderIconCircleButton}"
                                ToolTip="关于"
                                Command="{Binding ShowAboutCommand}"
                                hc:IconElement.Geometry="{StaticResource GeoAbout}" />
                        <Button Style="{StaticResource HeaderIconCircleButton}"
                                ToolTip="登出"
                                Command="{Binding LogoutCommand}"
                                hc:IconElement.Geometry="{StaticResource GeoLogout}" />
                        <Menu>
                            <MenuItem Header="...">
                                <MenuItem Header="程序截屏"
                                          Command="{Binding PrintScreenCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="{DynamicResource AddGeometry}"
                                              Fill="{DynamicResource SecondaryTextBrush}"
                                              Stretch="Uniform"
                                              Height="20"
                                              Width="20" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="打开程序日志"
                                          Command="{Binding ExplorerLogsCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="{DynamicResource AskGeometry}"
                                              Fill="{DynamicResource SecondaryTextBrush}"
                                              Stretch="Uniform"
                                              Height="20"
                                              Width="20" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="打开程序路径"
                                          Command="{Binding OpenAppPathCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="{DynamicResource EyeOpenGeometry}"
                                              Fill="{DynamicResource SecondaryTextBrush}"
                                              Stretch="Uniform"
                                              Height="20"
                                              Width="20" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="20">
                <hc:Card MaxWidth="1400"
                         Effect="{StaticResource EffectShadow2}"
                         BorderThickness="0"
                         Margin="0,0,0,16">
                    <ContentControl Content="{Binding CurrentPage}"
                                    Margin="0" />
                </hc:Card>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
