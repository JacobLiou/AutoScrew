<ui:FluentWindow x:Class="AutoScrew.Hmi.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
                 mc:Ignorable="d"
                 Title="{Binding AppTitle}"
                 Height="780"
                 Width="1280"
                 MinHeight="640"
                 MinWidth="960"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default"
                 WindowState="Maximized"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource ShellSurfaceBrush}"
                 SizeChanged="MainWindow_OnSizeChanged"
                 d:DataContext="{d:DesignInstance vm:MainShellViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <ui:NavigationView x:Name="NavigationView"
                           Padding="42,0,42,0"
                           BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
                           EnableDebugMessages="True"
                           FrameMargin="0"
                           IsBackButtonVisible="Visible"
                           IsPaneToggleVisible="True"
                           IsPaneOpen="{Binding IsSidebarVisible, Mode=TwoWay}"
                           MenuItemsSource="{Binding MenuItems}"
                           FooterMenuItemsSource="{Binding FooterMenuItems}"
                           OpenPaneLength="310"
                           PaneDisplayMode="Left"
                           SelectionChanged="RootNavigationView_OnSelectionChanged"
                           PaneOpened="NavigationView_OnPaneOpened"
                           PaneClosed="NavigationView_OnPaneClosed"
                           TitleBar="{Binding ElementName=TitleBar}"
                           Transition="FadeInWithSlide">
            <ui:NavigationView.Header>
                <StackPanel Margin="42,24,42,16">
                    <ui:BreadcrumbBar x:Name="BreadcrumbBar" />
                    <TextBlock Text="{Binding Breadcrumb}"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource ShellMutedForegroundBrush}"
                               FontSize="12" />
                </StackPanel>
            </ui:NavigationView.Header>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="12,16,12,8">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Image Source="pack://application:,,,/Assets/logo_new.png"
                               Height="28"
                               Width="100"
                               Stretch="Fill" />
                        <TextBlock Text="{DynamicResource S.App.ProductName}"
                                   FontSize="18"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ShellForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneHeader>
        </ui:NavigationView>

        <ContentPresenter x:Name="RootContentDialog" />
        <ui:TitleBar x:Name="TitleBar"
                     Title="{Binding AppTitle}"
                     CloseWindowByDoubleClickOnIcon="True">
            <!--<ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo_new.png" 
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"/>
            </ui:TitleBar.Icon>-->
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:Button Content="{DynamicResource S.Shell.Notepad}"
                               Style="{StaticResource ShellSecondaryButtonStyle}"
                               ToolTip="{DynamicResource S.Shell.Notepad}"
                               Command="{Binding OpenNotepadCommand}" />
                    <ui:Button Content="{DynamicResource S.Shell.Calculator}"
                               Style="{StaticResource ShellSecondaryButtonStyle}"
                               ToolTip="{DynamicResource S.Shell.Calculator}"
                               Command="{Binding OpenCalcCommand}" />
                    <ui:Button Style="{StaticResource HeaderIconButtonStyle}"
                               ToolTip="{DynamicResource S.Shell.Logout}"
                               Command="{Binding LogoutCommand}">
                        <ui:SymbolIcon Symbol="SignOut24" />
                    </ui:Button>
                    <Menu VerticalAlignment="Center">
                        <MenuItem Header="…">
                            <MenuItem Header="{DynamicResource S.Shell.Screenshot}"
                                      Command="{Binding PrintScreenCommand}" />
                            <Separator />
                            <MenuItem Header="{DynamicResource S.Shell.OpenLogs}"
                                      Command="{Binding ExplorerLogsCommand}" />
                            <MenuItem Header="{DynamicResource S.Shell.OpenAppPath}"
                                      Command="{Binding OpenAppPathCommand}" />
                        </MenuItem>
                    </Menu>
                    <Border Width="32"
                            Height="32"
                            CornerRadius="16"
                            Background="{DynamicResource ShellUserBadgeBrush}"
                            Margin="16,0,10,0">
                        <TextBlock Text="{Binding UserInitial}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Orientation="Horizontal">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding UserGreeting}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ShellForegroundBrush}" />
                            <TextBlock Text="{DynamicResource S.Shell.LoggedIn}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ShellMutedForegroundBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UserRoleDisplay}"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ShellMutedForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
