<Window x:Class="AutoScrew.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:AutoScrew.Hmi.Converters"
        xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
        xmlns:views="clr-namespace:AutoScrew.Hmi.Views"
        xmlns:tbvm="clr-namespace:AutoScrew.TemplateBoard.ViewModels;assembly=AutoScrew.TemplateBoard"
        xmlns:tbviews="clr-namespace:AutoScrew.TemplateBoard.Views;assembly=AutoScrew.TemplateBoard"
        mc:Ignorable="d"
        Title="AutoScrew 作业台"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="960"
        Background="#FFF0F2F5"
        d:DataContext="{d:DesignInstance vm:MainShellViewModel, IsDesignTimeCreatable=False}"
        Name="RootWindow">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:BooleanToGridLengthConverter x:Key="SidebarWidthConverter" ExpandedWidth="232"/>
        <Style x:Key="SidebarBreadcrumbButton" TargetType="Button" BasedOn="{StaticResource ButtonCustom}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="hc:BorderElement.CornerRadius" Value="8"/>
        </Style>
        <!-- 侧栏图标：作业台 / 模板 -->
        <PathGeometry x:Key="GeoSidebarOperation" Figures="M10,20 L10,14 L14,14 L14,20 L19,20 L19,12 L22,12 L12,3 L2,12 L5,12 L5,20 Z"/>
        <PathGeometry x:Key="GeoSidebarTemplate" Figures="M3,17 L3,21 L7,21 L18,10 L14,6 Z M20.71,7 L21,6.6 L21,6.1 L20.6,5.7 L18.4,3.5 L18,3.1 L17.5,3.1 L15.3,5.3 L19,9 Z"/>

        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:OperationPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type tbvm:MainWindowViewModel}">
            <tbviews:TemplateBoardView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsSidebarVisible, Converter={StaticResource SidebarWidthConverter}}" MinWidth="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧栏 -->
        <Border Grid.Column="0"
                Background="#FFF7F8FA"
                BorderBrush="#FFE5E7EB"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,20,16,12" BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="AutoScrew" FontSize="20" FontWeight="SemiBold" Foreground="#FF111827"/>
                        <TextBlock Text="智能锁附" FontSize="12" Foreground="#FF64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom"
                           Text="v1"
                           Foreground="#FF94A3B8"
                           FontSize="11"
                           Margin="16,8"/>

                <hc:SideMenu Margin="0,8,0,0" ExpandMode="Freedom">
                    <hc:SideMenuItem Header="Operation"
                                     Icon="{StaticResource GeoSidebarOperation}"
                                     Command="{Binding NavigateOperationCommand}"
                                     IsSelected="{Binding IsOperationNavSelected, Mode=OneWay}"/>
                    <hc:SideMenuItem Header="Template"
                                     Icon="{StaticResource GeoSidebarTemplate}"
                                     Command="{Binding NavigateTemplateCommand}"
                                     Visibility="{Binding CanUseTemplateBoard, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsSelected="{Binding IsTemplateNavSelected, Mode=OneWay}"/>
                </hc:SideMenu>
            </DockPanel>
        </Border>

        <!-- 主内容 -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top"
                    Background="White"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleHint}"
                            Style="{StaticResource SidebarBreadcrumbButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SidebarChromeIcon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#FF64748B"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Breadcrumb}"
                                       Margin="10,0,0,0"
                                       Foreground="#FF64748B"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#FF22C55E" Margin="0,0,10,0">
                            <TextBlock Text="{Binding UserInitial}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UserGreeting}"
                                           FontWeight="SemiBold"
                                           Foreground="#FF111827" />
                            </StackPanel>
                            <TextBlock Text="已登录" FontSize="11" Foreground="#FF64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UserRoleDisplay}"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   Foreground="#FF64748B"
                                   VerticalAlignment="Center" />
                        <Button Content="关于"
                                Margin="16,0,0,0"
                                Padding="12,6"
                                Command="{Binding ShowAboutCommand}"
                                Style="{StaticResource ButtonDefault}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <hc:Card MaxWidth="1400" Effect="{StaticResource EffectShadow2}" BorderThickness="0" Margin="0,0,0,16">
                    <ContentControl Content="{Binding CurrentPage}" Margin="0"/>
                </hc:Card>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
