<Window x:Class="AutoScrew.Hmi.Views.ControllerDevice.ProcessLibrarySlotPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource S.ControllerParam.ImportProcessLibraryTitle}"
        Width="620"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="400"
        MinHeight="360"
        Background="#F5F7FA">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E88E5" Padding="12,10">
            <Grid>
                <TextBlock Text="{DynamicResource S.ControllerParam.ImportProcessLibraryTitle}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="16"
                        Content="×"
                        Click="Close_Click" />
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="16">
            <ui:Button MinWidth="120"
                       Appearance="Secondary"
                       Content="{DynamicResource S.Common.Cancel}"
                       Click="Close_Click" />
            <ui:Button Margin="12,0,0,0"
                       MinWidth="140"
                       Appearance="Secondary"
                       Content="{DynamicResource S.ControllerParam.ImportProcessLibraryAll}"
                       Click="ImportAll_Click" />
            <ui:Button Margin="12,0,0,0"
                       MinWidth="120"
                       Appearance="Primary"
                       Content="{DynamicResource S.Common.Confirm}"
                       Click="Select_Click" />
        </StackPanel>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource S.ProcessLibrary.ProductPn}" />
                <ComboBox x:Name="ProductCombo"
                          IsEditable="True"
                          ItemsSource="{Binding ProductPns}"
                          Text="{Binding ProductPn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <TextBlock Grid.Row="2"
                       Foreground="#546E7A"
                       Text="{DynamicResource S.ControllerParam.ImportProcessLibraryHint}"
                       TextWrapping="Wrap" />

            <Border Grid.Row="4"
                    BorderBrush="#CFD8DC"
                    BorderThickness="1"
                    Background="White">
                <ListBox x:Name="SlotList"
                         SelectionMode="Extended"
                         ItemsSource="{Binding Slots}"
                         SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                         BorderThickness="0"
                         MouseDoubleClick="SlotList_OnMouseDoubleClick"
                         KeyDown="SlotList_OnKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SlotLabel}"
                                           VerticalAlignment="Center"
                                           Foreground="#546E7A" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ScrewPn}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding FileName}"
                                           VerticalAlignment="Center"
                                           Foreground="#78909C" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </DockPanel>
</Window>
