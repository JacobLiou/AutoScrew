<Window x:Class="AutoScrew.Hmi.Views.ControllerDevice.LoosenAdvancedSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance vm:ControllerParameterLoosenItem, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="{DynamicResource S.ControllerParam.LoosenAdvancedTitle}"
        Width="400"
        Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E88E5" Padding="12,10">
            <Grid>
                <TextBlock Text="{DynamicResource S.ControllerParam.LoosenAdvancedTitle}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="16"
                        Content="×"
                        Click="Close_Click" />
            </Grid>
        </Border>
        <Button DockPanel.Dock="Bottom"
                Margin="16"
                Height="40"
                HorizontalAlignment="Right"
                Content="{DynamicResource S.Common.Confirm}"
                Click="Close_Click" />
        <StackPanel Margin="16,12">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,10,0"
                           Text="{DynamicResource S.ControllerParam.Direction}" />
                <ComboBox Grid.Column="1" SelectedIndex="{Binding DirectionIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource S.ControllerParam.DirectionCw}" />
                    <ComboBoxItem Content="{DynamicResource S.ControllerParam.DirectionCcw}" />
                </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,10,0"
                           Text="{DynamicResource S.ControllerParam.Loosen.Stage1Accel}" />
                <ui:NumberBox Grid.Column="1" Value="{Binding Stage1AccelMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Text="{DynamicResource S.ControllerParam.Unit.Ms}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,10,0"
                           Text="{DynamicResource S.ControllerParam.Loosen.Stage2Accel}" />
                <ui:NumberBox Grid.Column="1" Value="{Binding Stage2AccelMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Text="{DynamicResource S.ControllerParam.Unit.Ms}" />
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
