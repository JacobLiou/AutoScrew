<Window x:Class="AutoScrew.Hmi.Views.ControllerDevice.SourceAdvancedSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:cfg="clr-namespace:AutoScrew.Application.Configuration;assembly=AutoScrew.Application"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=cfg:SourceAdvancedSettingsCore, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="{DynamicResource S.Workbench.Source.AdvancedTitle}"
        Width="520"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="480"
        MinHeight="480"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="OnOffToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="14" Background="#9AA0A6" Padding="4,0">
                            <TextBlock x:Name="Txt"
                                       Text="OFF"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E88E5" />
                                <Setter TargetName="Txt" Property="Text" Value="ON" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdvRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E88E5" Padding="12,10">
            <Grid>
                <TextBlock Text="{DynamicResource S.Workbench.Source.AdvancedTitle}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="16"
                        Content="×"
                        Click="Close_Click" />
            </Grid>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Margin="0,0,8,0"
                       Appearance="Secondary"
                       Content="{DynamicResource S.Common.Cancel}"
                       Click="Close_Click" />
            <ui:Button Appearance="Primary"
                       Content="{DynamicResource S.Common.Confirm}"
                       Click="Confirm_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Text="{DynamicResource S.Workbench.Source.Adv.TorqueUnit}" />
                        <ComboBox SelectedIndex="{Binding StartConditionTorqueUnitIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="N.m" />
                            <ComboBoxItem Content="kgf.cm" />
                            <ComboBoxItem Content="lbf.ft" />
                            <ComboBoxItem Content="lbf.in" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,4" Text="{DynamicResource S.Workbench.Source.Adv.StartCondition}" />
                        <ComboBox SelectedIndex="{Binding StartConditionTriggerIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.Workbench.Source.Adv.Start.Push}" />
                            <ComboBoxItem Content="{DynamicResource S.Workbench.Source.Adv.Start.Di}" />
                            <ComboBoxItem Content="{DynamicResource S.Workbench.Source.Adv.Start.Lever}" />
                            <ComboBoxItem Content="{DynamicResource S.Workbench.Source.Adv.Start.PushOrLever}" />
                            <ComboBoxItem Content="{DynamicResource S.Workbench.Source.Adv.Start.PushAndLever}" />
                            <ComboBoxItem Content="{DynamicResource S.Workbench.Source.Adv.Start.DiOrPush}" />
                            <ComboBoxItem Content="{DynamicResource S.Workbench.Source.Adv.Start.DiOrLever}" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="1." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.ProhibitLoosenOk}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding ProhibitLoosenAfterTightenOk, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="2." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.ProhibitLoosenNg}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding ProhibitLoosenAfterTightenNg, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="3." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.LimitTightenNg}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding LimitMaxTightenNgPerScrew, Mode=TwoWay}" />
                            <ui:NumberBox Grid.Column="3" Margin="8,0,0,0" Value="{Binding MaxTightenNgPerScrew, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="4." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.LimitLoosenNg}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding LimitMaxLoosenNgPerScrew, Mode=TwoWay}" />
                            <ui:NumberBox Grid.Column="3" Margin="8,0,0,0" Value="{Binding MaxLoosenNgPerScrew, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="5." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.AutoNextOnTightenNg}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding AutoNextOnTightenNg, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="6." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.GoBackOnLoosenOk}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding GoBackOnLoosenOk, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="7." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.ProhibitEmptyBarcode}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding ProhibitStartWhenBarcodeEmpty, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="8." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.ClearBarcode}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding ClearBarcodeWhenScrewCountComplete, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="9." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.ProhibitScanIncomplete}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding ProhibitScanWhenScrewCountIncomplete, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="10." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.LimitRunTime}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding LimitMaxRunTime, Mode=TwoWay}" />
                            <ui:NumberBox Grid.Column="3" Margin="8,0,0,0" Value="{Binding MaxRunTimeSeconds, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="11." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.ResetCount}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding ResetCountWhenScrewCountComplete, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="12." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.PromptSignalEarly}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding PromptWhenTightenSignalDisappearsEarly, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource AdvRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Width="28" Foreground="#789" Text="13." />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource S.Workbench.Source.Adv.ProhibitBarcodeLength}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource OnOffToggle}" IsChecked="{Binding ProhibitStartWhenBarcodeLengthMismatch, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
