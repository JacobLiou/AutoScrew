<ui:FluentWindow x:Class="AutoScrew.Hmi.Views.ControllerDevice.ExportSequenceExcelDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title=""
                 MinWidth="440"
                 Width="480"
                 SizeToContent="Height"
                 WindowStyle="None"
                 WindowBackdropType="None"
                 Background="{DynamicResource ShellCardBrush}"
                 MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource S.ControllerSeq.ExportSequenceExcelTitle}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ShellMutedForegroundBrush}"
                   Text="{DynamicResource S.ControllerSeq.ExportSequenceExcelHint}" />
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource S.ControllerSeq.ExportDefaultScrewPn}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <ui:TextBox x:Name="txt_DefaultScrewPn" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource S.ControllerSeq.ExportLocationMode}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <ComboBox x:Name="cmb_LocationMode" />
            <ui:TextBox x:Name="txt_Prefix"
                        Margin="0,8,0,0"
                        PlaceholderText="{DynamicResource S.ControllerSeq.ExportLocationPrefixPlaceholder}"
                        Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="txt_Validation"
                   Grid.Row="4"
                   Foreground="{DynamicResource BrushNg}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="Collapsed" />
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <ui:Button Content="{DynamicResource S.Common.Ok}"
                       Appearance="Primary"
                       MinWidth="100"
                       Margin="0,0,8,0"
                       Click="btn_OK_Click" />
            <ui:Button Content="{DynamicResource S.Common.Cancel}"
                       Appearance="Secondary"
                       MinWidth="100"
                       Click="btn_Cancel_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
