<UserControl x:Class="AutoScrew.Hmi.BusinessDialog.ProductInfoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="420"
             Height="280"
             Background="{DynamicResource ShellCardBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource S.Template.ProductPn}" Margin="0,0,0,4" />
        <ui:TextBox x:Name="ProductIdBox"
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    PlaceholderText="{DynamicResource S.Template.PnPlaceholder}" />
        <TextBlock Grid.Row="2" Text="{DynamicResource S.Template.DisplayName}" Margin="0,0,0,4" />
        <ui:TextBox x:Name="DisplayNameBox"
                    Grid.Row="3"
                    Margin="0,0,0,12"
                    PlaceholderText="{DynamicResource S.Template.DisplayNamePlaceholder}" />
        <StackPanel Grid.Row="4">
            <TextBlock Text="{DynamicResource S.Template.Revision}" Margin="0,0,0,4" />
            <ui:TextBox x:Name="RevisionBox" PlaceholderText="{DynamicResource S.Template.RevisionPlaceholder}" />
            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       Foreground="#C62828"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
