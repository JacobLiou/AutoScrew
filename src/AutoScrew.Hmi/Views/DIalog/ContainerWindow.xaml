<ui:FluentWindow x:Class="AutoScrew.Hmi.Dialog.ContainerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title=""
                 ResizeMode="NoResize"
                 Height="600"
                 Width="800"
                 WindowBackdropType="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="contentControl" />
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="18,12">
            <ui:Button x:Name="btn_OK"
                       Content="{DynamicResource S.Common.Confirm}"
                       Appearance="Primary"
                       MinWidth="100"
                       Margin="0,0,8,0"
                       Click="btn_Confirm_Click" />
            <ui:Button x:Name="btn_Cancel"
                       Content="{DynamicResource S.Common.Cancel}"
                       Appearance="Secondary"
                       MinWidth="100"
                       Click="btn_Cancel_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
