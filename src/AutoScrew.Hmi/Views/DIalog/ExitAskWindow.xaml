<ui:FluentWindow x:Class="AutoScrew.Hmi.Dialog.ExitAskWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title=""
                 Height="300"
                 Width="500"
                 WindowStartupLocation="CenterOwner"
                 WindowStyle="None"
                 WindowBackdropType="None"
                 Background="{DynamicResource ShellCardBrush}"
                 MouseLeftButtonDown="Window_MouseLeftButtonDown"
                 Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Warning24" Foreground="#FFEAB308" />
            <TextBlock Text="{DynamicResource S.Common.Warning}"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16">
            <TextBlock Text="{DynamicResource S.ExitAskWindow.ExitAskWindow_Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource S.ExitAskWindow.ExitAskWindow_Content}"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       TextAlignment="Center"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <ui:Button x:Name="btn_Confirm"
                       Content="{DynamicResource S.Common.Confirm}"
                       Appearance="Primary"
                       MinWidth="100"
                       Margin="0,0,16,0"
                       Click="btn_Confirm_Click" />
            <ui:Button x:Name="btn_Cancel"
                       Content="{DynamicResource S.Common.Cancel}"
                       Appearance="Secondary"
                       MinWidth="100"
                       Click="btn_Cancel_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
