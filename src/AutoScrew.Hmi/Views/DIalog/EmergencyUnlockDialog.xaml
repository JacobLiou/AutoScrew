<ui:FluentWindow x:Class="AutoScrew.Hmi.Dialog.EmergencyUnlockDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title=""
                 MinHeight="340"
                 MinWidth="440"
                 Width="480"
                 SizeToContent="Height"
                 WindowStyle="None"
                 WindowBackdropType="None"
                 Background="{DynamicResource ShellCardBrush}"
                 MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource BrushNg}" />
            <TextBlock x:Name="txt_Title"
                       Text="{DynamicResource S.Operation.EmergencyUnlockTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="{DynamicResource S.Operation.EmergencyUnlockUserLabel}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="txt_User"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ShellMutedForegroundBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{DynamicResource S.Operation.EmergencyUnlockReasonLabel}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <ui:TextBox x:Name="txt_Reason"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="88" />
            <TextBlock x:Name="txt_Validation"
                       Foreground="{DynamicResource BrushNg}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
        <TextBlock Grid.Row="3"
                   Text="{DynamicResource S.Operation.EmergencyUnlockWarn}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ShellMutedForegroundBrush}"
                   Margin="0,12,0,0" />
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button Content="{DynamicResource S.Operation.EmergencyUnlockConfirm}"
                       Appearance="Danger"
                       MinWidth="120"
                       Margin="0,0,8,0"
                       Click="btn_OK_Click" />
            <ui:Button Content="{DynamicResource S.Common.Cancel}"
                       Appearance="Secondary"
                       MinWidth="100"
                       Click="btn_Cancel_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
