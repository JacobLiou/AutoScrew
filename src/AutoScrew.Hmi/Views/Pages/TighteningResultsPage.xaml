<UserControl x:Class="AutoScrew.Hmi.Views.Pages.TighteningResultsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:AutoScrew.Hmi.Views.Controls"
             xmlns:local="clr-namespace:AutoScrew.Hmi.Views.Pages"
             d:DataContext="{d:DesignInstance Type=local:TighteningResultsPage, IsDesignTimeCreatable=False}"
             d:DesignHeight="720"
             d:DesignWidth="960"
             mc:Ignorable="d"
             IsVisibleChanged="OnIsVisibleChanged">
    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:CardControl Grid.Row="0" Margin="0,0,0,12" Icon="{ui:SymbolIcon DataHistogram24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource S.Results.Title}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{DynamicResource S.Results.Desc}"
                                  TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
        </ui:CardControl>

        <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="16">
            <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong"
                              Margin="0,0,0,8"
                              Text="{DynamicResource S.Results.Summary}" />
                <ui:TextBlock Text="{Binding ViewModel.SnPnText}"
                              TextWrapping="Wrap"
                              Margin="0,0,0,12" />
                <UniformGrid Columns="3" Rows="2">
                    <StackPanel Margin="0,0,16,8">
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{DynamicResource S.Results.Torque}" />
                        <ui:TextBlock FontTypography="Subtitle"
                                      Text="{Binding ViewModel.TorqueText}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{DynamicResource S.Results.Angle}" />
                        <ui:TextBlock FontTypography="Subtitle"
                                      Text="{Binding ViewModel.AngleText}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{DynamicResource S.Results.OkNg}" />
                        <ui:TextBlock FontTypography="Subtitle"
                                      Text="{Binding ViewModel.OkNgText}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{DynamicResource S.Results.ReportId}" />
                        <ui:TextBlock Text="{Binding ViewModel.ReportIdText}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{DynamicResource S.Results.PointCount}" />
                        <ui:TextBlock Text="{Binding ViewModel.PointCountText}" />
                    </StackPanel>
                    <StackPanel>
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{DynamicResource S.Results.CurveStatus}" />
                        <ui:TextBlock Text="{Binding ViewModel.CurveStatusText}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="2" Padding="12">
            <ctrl:TighteningCurvePlotView x:Name="CurvePlot" MinHeight="280" />
        </ui:Card>
    </Grid>
</UserControl>
