<UserControl x:Class="AutoScrew.Hmi.Views.Pages.LanFileMaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
             xmlns:conv="clr-namespace:AutoScrew.Hmi.Converters"
             d:DataContext="{d:DesignInstance Type=vm:LanFileMaintenanceViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="720"
             d:DesignWidth="960"
             mc:Ignorable="d"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse" />
    </UserControl.Resources>

    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:CardControl Grid.Row="0" Margin="0,0,0,12" Icon="{ui:SymbolIcon ShieldLock24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource S.LanFile.Title}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{DynamicResource S.LanFile.Desc}"
                                  TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel>
                <ui:TextBlock Margin="0,0,0,4"
                              FontTypography="Caption"
                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                              Text="{DynamicResource S.LanFile.LanRoot}" />
                <ui:TextBlock Margin="0,0,0,8"
                              Text="{Binding ViewModel.LanRootDisplay}"
                              TextWrapping="Wrap"
                              FontSize="12"
                              Opacity="0.85" />
                <ui:TextBlock Text="{Binding ViewModel.StatusMessage}"
                              TextWrapping="Wrap"
                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Unlock overlay -->
        <Border Grid.Row="1"
                Padding="24"
                CornerRadius="8"
                Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                BorderThickness="1"
                Visibility="{Binding ViewModel.IsUnlocked, Converter={StaticResource BoolToVisInverse}}">
            <StackPanel MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top">
                <ui:TextBlock FontTypography="BodyStrong"
                              Margin="0,0,0,8"
                              Text="{DynamicResource S.LanFile.UnlockTitle}" />
                <ui:TextBlock Margin="0,0,0,12"
                              TextWrapping="Wrap"
                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                              Text="{DynamicResource S.LanFile.UnlockHint}" />
                <ui:TextBlock Margin="0,0,0,4"
                              FontTypography="Caption"
                              Text="{DynamicResource S.LanFile.Account}" />
                <ui:TextBlock Margin="0,0,0,12"
                              FontSize="16"
                              Text="{Binding ViewModel.ServiceAccountDisplay}" />
                <ui:TextBlock Margin="0,0,0,4"
                              FontTypography="Caption"
                              Text="{DynamicResource S.LanFile.Password}" />
                <ui:PasswordBox x:Name="UnlockPasswordBox"
                               Margin="0,0,0,12"
                               MinHeight="36" />
                <ui:Button Appearance="Primary"
                           MinHeight="36"
                           HorizontalAlignment="Left"
                           Command="{Binding ViewModel.UnlockCommand}"
                           Content="{DynamicResource S.LanFile.Unlock}"
                           Icon="{ui:SymbolIcon Key24}" />
                <ui:TextBlock Margin="0,12,0,0"
                              TextWrapping="Wrap"
                              Text="{Binding ViewModel.UnlockStatusMessage}" />
            </StackPanel>
        </Border>

        <!-- Main ops -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ViewModel.IsUnlocked, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                    <ui:TextBlock DockPanel.Dock="Left"
                                  VerticalAlignment="Center"
                                  FontTypography="BodyStrong"
                                  Text="{DynamicResource S.LanFile.Unlocked}" />
                    <ui:Button DockPanel.Dock="Right"
                               Appearance="Secondary"
                               Command="{Binding ViewModel.LockSessionCommand}"
                               Content="{DynamicResource S.LanFile.Lock}"
                               Icon="{ui:SymbolIcon LockClosed24}" />
                </DockPanel>

                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon ArrowSwap24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="{DynamicResource S.LanFile.SyncTitle}" />
                            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="{DynamicResource S.LanFile.SyncDesc}"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Margin="0,0,0,4" FontTypography="Caption"
                                      Text="{DynamicResource S.LanFile.SourceDir}" />
                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                            <ui:Button DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       Command="{Binding ViewModel.BrowseSourceCommand}"
                                       Content="{DynamicResource S.LanFile.Browse}" />
                            <TextBox MinHeight="36"
                                     Text="{Binding ViewModel.SourceDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ui:TextBlock Margin="0,0,0,4" FontTypography="Caption"
                                      Text="{DynamicResource S.LanFile.TargetDir}" />
                        <DockPanel Margin="0,0,0,12" LastChildFill="True">
                            <ui:Button DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       Command="{Binding ViewModel.BrowseTargetCommand}"
                                       Content="{DynamicResource S.LanFile.Browse}" />
                            <TextBox MinHeight="36"
                                     Text="{Binding ViewModel.TargetDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ui:Button Appearance="Caution"
                                   MinHeight="36"
                                   HorizontalAlignment="Left"
                                   Command="{Binding ViewModel.SyncDirectoriesCommand}"
                                   Content="{DynamicResource S.LanFile.SyncStart}"
                                   Icon="{ui:SymbolIcon ArrowSync24}" />
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Icon="{ui:SymbolIcon FolderOpen24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="{DynamicResource S.LanFile.ExplorerTitle}" />
                            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="{DynamicResource S.LanFile.ExplorerDesc}"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Margin="0,0,0,4" FontTypography="Caption"
                                      Text="{DynamicResource S.LanFile.ExplorerPath}" />
                        <DockPanel Margin="0,0,0,12" LastChildFill="True">
                            <ui:Button DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       Command="{Binding ViewModel.BrowseExplorerPathCommand}"
                                       Content="{DynamicResource S.LanFile.Browse}" />
                            <TextBox MinHeight="36"
                                     Text="{Binding ViewModel.ExplorerPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ui:Button Appearance="Primary"
                                   MinHeight="36"
                                   HorizontalAlignment="Left"
                                   Command="{Binding ViewModel.OpenExplorerCommand}"
                                   Content="{DynamicResource S.LanFile.OpenExplorer}"
                                   Icon="{ui:SymbolIcon Open24}" />
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
