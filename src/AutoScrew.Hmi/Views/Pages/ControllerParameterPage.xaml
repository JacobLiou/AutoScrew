<UserControl x:Class="AutoScrew.Hmi.Views.Pages.ControllerParameterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:device="clr-namespace:AutoScrew.Hmi.Views.ControllerDevice"
             xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:ControllerParameterViewModel, IsDesignTimeCreatable=False}"
             IsVisibleChanged="OnIsVisibleChanged"
             mc:Ignorable="d">
    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
            <ui:TextBlock Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="{DynamicResource S.ControllerParam.DeviceStatus}" />
            <ui:TextBlock VerticalAlignment="Center"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="{Binding ViewModel.DeviceStatusText}"
                          TextWrapping="Wrap" />
        </StackPanel>
        <device:ParameterEditorView Grid.Row="1" DataContext="{Binding ViewModel}" />
    </Grid>
</UserControl>
