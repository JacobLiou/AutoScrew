<UserControl x:Class="AutoScrew.Hmi.Views.Pages.DeviceExceptionHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:DeviceExceptionHistoryViewModel, IsDesignTimeCreatable=False}"
             IsVisibleChanged="OnIsVisibleChanged"
             mc:Ignorable="d">
    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
            <ui:TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="{DynamicResource S.ControllerParam.DeviceStatus}" />
            <ui:TextBlock VerticalAlignment="Center" FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="{Binding ViewModel.DeviceStatusText}" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ui:Button Margin="0,0,8,0" Command="{Binding ViewModel.RefreshCommand}"
                       Content="{DynamicResource S.DeviceHistory.Refresh}" />
            <ui:TextBlock VerticalAlignment="Center"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="{Binding ViewModel.StatusMessage}" />
        </WrapPanel>
        <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" ItemsSource="{Binding ViewModel.Rows}" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Width="180" Binding="{Binding TimestampText}"
                                    Header="{DynamicResource S.DeviceHistory.Col.DateTime}" />
                <DataGridTextColumn Width="120" Binding="{Binding CodeText}"
                                    Header="{DynamicResource S.DeviceHistory.Col.AlNgCode}" />
                <DataGridTextColumn Width="*" Binding="{Binding DescriptionText}"
                                    Header="{DynamicResource S.DeviceHistory.Col.Description}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Command="{Binding ViewModel.PreviousPageCommand}" Content="&lt;" />
            <Border MinWidth="48" Padding="12,4" Background="{ui:ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4">
                <TextBlock HorizontalAlignment="Center" Text="{Binding ViewModel.PageDisplay}" />
            </Border>
            <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.NextPageCommand}" Content="&gt;" />
        </StackPanel>
    </Grid>
</UserControl>
