<UserControl x:Class="AutoScrew.Hmi.Views.Pages.DeviceConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
             d:DataContext="{d:DesignInstance vm:DeviceConnectionViewModel, IsDesignTimeCreatable=False}"
             Loaded="OnLoaded"
             mc:Ignorable="d">
    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12"
                    Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0"
                       Appearance="Primary"
                       Command="{Binding ViewModel.SaveCommand}"
                       Content="{DynamicResource S.Device.Save}" />
            <ui:Button Margin="0,0,8,0"
                       Command="{Binding ViewModel.RefreshSerialPortsCommand}"
                       Content="{DynamicResource S.Device.RefreshPorts}" />
            <ui:Button Margin="0,0,8,0"
                       Command="{Binding ViewModel.TestConnectionCommand}"
                       Content="{DynamicResource S.Device.TestConnection}" />
            <ui:Button Command="{Binding ViewModel.ApplyCommand}"
                       Content="{DynamicResource S.Device.Apply}" />
        </StackPanel>

        <ui:InfoBar Grid.Row="1"
                    Margin="0,0,0,8"
                    IsOpen="True"
                    Message="{Binding ViewModel.StatusMessage}"
                    Severity="Informational"
                    Title="{DynamicResource S.Device.StationTitle}" />

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,12"
                   Text="{Binding ViewModel.StationId, StringFormat={DynamicResource S.Device.StationIdFormat}}" />

        <TabControl Grid.Row="3"
                    ItemsSource="{Binding ViewModel.Slots}"
                    SelectedIndex="{Binding ViewModel.SelectedSlotIndex, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StationDeviceSlotEditor}">
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:StationDeviceSlotEditor}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox Margin="0,0,0,8"
                                      Content="{DynamicResource S.Device.Enabled}"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}" />
                            <ui:Button Margin="0,0,0,12"
                                       HorizontalAlignment="Left"
                                       Command="{Binding DataContext.ViewModel.SetActiveSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding SlotIndex}"
                                       Content="{DynamicResource S.Device.SetActive}" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource S.ControllerParam.Name}" />
                                <ui:TextBox Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,0,8"
                                            Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource S.Device.Transport}" />
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="0,0,0,8"
                                          SelectedIndex="{Binding TransportIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource S.Device.TransportTcp}" />
                                    <ComboBoxItem Content="{DynamicResource S.Device.TransportSerial}" />
                                </ComboBox>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource S.Device.ToolIndex}" />
                                <ui:NumberBox Grid.Row="2"
                                              Grid.Column="1"
                                              Maximum="1"
                                              Minimum="0"
                                              Value="{Binding ToolIndex, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTcp}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource S.Device.Host}" />
                                <ui:TextBox Grid.Column="1"
                                            Margin="0,0,12,0"
                                            Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource S.Device.Port}" />
                                <ui:NumberBox Grid.Column="3"
                                              Value="{Binding Port, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTcp}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource S.Device.SerialPort}" />
                                <ComboBox Grid.Column="1"
                                          Margin="0,0,12,0"
                                          IsEditable="True"
                                          ItemsSource="{Binding DataContext.ViewModel.SerialPortOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Text="{Binding SerialPortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource S.Device.BaudRate}" />
                                <ui:NumberBox Grid.Column="3"
                                              Value="{Binding BaudRate, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource S.Device.CommandTimeout}" />
                                <ui:NumberBox Grid.Column="1"
                                              Value="{Binding CommandTimeoutMs, Mode=TwoWay}" />
                            </Grid>

                            <ComboBox SelectedIndex="{Binding TriggerModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource S.Device.TriggerAutoDi}" />
                                <ComboBoxItem Content="{DynamicResource S.Device.TriggerManual}" />
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                   Text="{Binding ViewModel.StatusMessage}" />
    </Grid>
</UserControl>
