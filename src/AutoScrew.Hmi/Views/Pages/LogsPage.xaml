<UserControl x:Class="AutoScrew.Hmi.Views.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
             d:DataContext="{d:DesignInstance vm:LogsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:Background="White"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="53" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:Button Appearance="Primary"
                           Margin="0,0,8,0"
                           Command="{Binding ViewModel.OpenLogsFolderCommand}"
                           Content="{DynamicResource S.Logs.OpenFolder}" />
                <ui:Button Margin="0,0,8,0"
                           Command="{Binding ViewModel.RefreshCommand}"
                           Content="{DynamicResource S.Common.Refresh}" />
                <ui:Button Command="{Binding ViewModel.OpenSelectedCommand}"
                           Content="{DynamicResource S.Logs.OpenFile}" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ui:Button Margin="0,0,8,0"
                           Command="{Binding ViewModel.FirstPageCommand}"
                           IsEnabled="{Binding ViewModel.HasPreviousPage}"
                           Content="|&lt;" />
                <ui:Button Margin="0,0,8,0"
                           Command="{Binding ViewModel.PreviousPageCommand}"
                           IsEnabled="{Binding ViewModel.HasPreviousPage}"
                           Content="&lt;" />
                <ui:TextBlock Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Text="{Binding ViewModel.PageInfo}" />
                <ui:Button Margin="0,0,8,0"
                           Command="{Binding ViewModel.NextPageCommand}"
                           IsEnabled="{Binding ViewModel.HasNextPage}"
                           Content="&gt;" />
                <ui:Button Command="{Binding ViewModel.LastPageCommand}"
                           IsEnabled="{Binding ViewModel.HasNextPage}"
                           Content="&gt;|" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:CardControl Grid.Column="0"
                            Icon="{ui:SymbolIcon DocumentText24}"
                            VerticalAlignment="Top">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{DynamicResource S.Logs.FileList}" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{DynamicResource S.Logs.FileListDesc}" />
                    </Grid>
                </ui:CardControl.Header>
                <ListBox Margin="0,12,0,0"
                         ItemsSource="{Binding ViewModel.LogFiles}"
                         DisplayMemberPath="FileName"
                         SelectedItem="{Binding ViewModel.SelectedLogFile, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Grid.Column="2"
                            Icon="{ui:SymbolIcon TextDescription24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{DynamicResource S.Logs.Preview}" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{DynamicResource S.Logs.PreviewDesc}" />
                    </Grid>
                </ui:CardControl.Header>
                <TextBox Margin="0,12,0,0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Height="350"
                         Text="{Binding ViewModel.SelectedLogPreview}"
                         IsReadOnly="True"
                         TextWrapping="NoWrap" />
            </ui:CardControl>
        </Grid>
    </Grid>
</UserControl>
