<UserControl x:Class="AutoScrew.Hmi.Views.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
             d:DataContext="{d:DesignInstance vm:LogsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:Background="White"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">
            <ui:TextBlock Margin="0,0,0,12"
                          FontTypography="Title"
                          Text="日志" />
            <StackPanel Orientation="Horizontal">
                <ui:Button Appearance="Primary"
                           Margin="0,0,8,0"
                           Command="{Binding ViewModel.OpenLogsFolderCommand}"
                           Content="打开日志目录" />
                <ui:Button Margin="0,0,8,0"
                           Command="{Binding ViewModel.RefreshCommand}"
                           Content="刷新" />
                <ui:Button Command="{Binding ViewModel.OpenSelectedCommand}"
                           Content="打开选中文件" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:CardControl Grid.Column="0"
                            Icon="{ui:SymbolIcon DocumentText24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="文件列表" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="默认显示 Logs 目录下的 .log/.txt" />
                    </Grid>
                </ui:CardControl.Header>
                <ListBox Margin="0,12,0,0"
                         ItemsSource="{Binding ViewModel.LogFiles}"
                         SelectedItem="{Binding ViewModel.SelectedLogFile, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Grid.Column="2"
                            Icon="{ui:SymbolIcon TextDescription24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="预览" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="最多显示 8000 字符" />
                    </Grid>
                </ui:CardControl.Header>
                <TextBox Margin="0,12,0,0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding ViewModel.SelectedLogPreview}"
                         IsReadOnly="True"
                         TextWrapping="NoWrap" />
            </ui:CardControl>
        </Grid>
    </Grid>
</UserControl>

