<UserControl x:Class="AutoScrew.Hmi.Views.Pages.ControllerSourcePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
             Loaded="OnLoaded"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding ViewModel.SaveLocalCommand}" Content="{DynamicResource S.ControllerParam.SaveLocal}" />
            <ui:Button Margin="0,0,8,0" Command="{Binding ViewModel.ReadFromDeviceCommand}" Content="{DynamicResource S.ControllerParam.ReadDevice}" />
            <ui:Button Command="{Binding ViewModel.WriteToDeviceCommand}" Content="{DynamicResource S.ControllerParam.WriteDevice}" />
        </StackPanel>

        <ui:InfoBar Grid.Row="1" Margin="0,0,0,12" IsOpen="True"
                    Message="{Binding ViewModel.DeviceStatusText}" Severity="Informational"
                    Title="{DynamicResource S.ControllerParam.DeviceStatus}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="{DynamicResource S.ControllerSource.ProductionMode}" />
                <ComboBox Margin="0,0,0,16" SelectedIndex="{Binding ViewModel.ProductionControlModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource S.ControllerSource.ModeHostGuided}" />
                    <ComboBoxItem Content="{DynamicResource S.ControllerSource.ModeDeviceProgram}" />
                </ComboBox>

                <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="{DynamicResource S.ControllerSource.ModeSettings}" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Tool" />
                    <ui:NumberBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Value="{Binding ViewModel.ToolIndex, Mode=TwoWay}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="{DynamicResource S.ControllerSource.OperatingMode}" />
                    <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" SelectedIndex="{Binding ViewModel.OperatingModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{DynamicResource S.ControllerSource.OpSingle}" />
                        <ComboBoxItem Content="{DynamicResource S.ControllerSource.OpDualAlt}" />
                        <ComboBoxItem Content="{DynamicResource S.ControllerSource.OpDualSync}" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource S.ControllerSource.SwitchingMethod}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" SelectedIndex="{Binding ViewModel.SwitchingMethodIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{DynamicResource S.ControllerSource.SwitchManual}" />
                        <ComboBoxItem Content="{DynamicResource S.ControllerSource.SwitchBit}" />
                        <ComboBoxItem Content="{DynamicResource S.ControllerSource.SwitchBarcode}" />
                    </ComboBox>
                </Grid>

                <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="{DynamicResource S.ControllerSource.Content}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource S.ControllerSource.BindingType}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" SelectedIndex="{Binding ViewModel.BindingTypeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{DynamicResource S.ControllerSource.BindParameter}" />
                        <ComboBoxItem Content="{DynamicResource S.ControllerSource.BindSequence}" />
                    </ComboBox>
                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="ID" />
                    <ui:NumberBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" Value="{Binding ViewModel.TargetId, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource S.ControllerSource.ScrewCount}" />
                    <ui:NumberBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Value="{Binding ViewModel.ScrewCount, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Bit ID" />
                    <ui:NumberBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" Value="{Binding ViewModel.BitId, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource S.ControllerSource.Barcode}" />
                    <ui:TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ViewModel.Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding ViewModel.StatusMessage}" />
    </Grid>
</UserControl>
