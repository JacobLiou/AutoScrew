<UserControl x:Class="AutoScrew.Hmi.Views.Pages.ControllerWorkbenchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:AutoScrew.Hmi.Converters"
             xmlns:steps="clr-namespace:AutoScrew.Hmi.Views.ControllerWorkbench.Steps"
             xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
             d:DataContext="{d:DesignInstance vm:ControllerWorkbenchViewModel, IsDesignTimeCreatable=False}"
             Loaded="OnLoaded"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              FontTypography="BodyStrong"
                              Text="{DynamicResource S.Workbench.ProductionMode}" />
                <ComboBox Grid.Column="1"
                          Width="360"
                          VerticalAlignment="Center"
                          SelectedIndex="{Binding ViewModel.ProductionControlModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource S.ControllerSource.ModeHostGuided}" />
                    <ComboBoxItem Content="{DynamicResource S.ControllerSource.ModeDeviceProgram}" />
                </ComboBox>
            </Grid>
            <StackPanel Grid.Row="1"
                        Margin="0,4,0,0"
                        Orientation="Horizontal">
                <ui:TextBlock Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              FontTypography="Caption"
                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                              Text="{DynamicResource S.ControllerParam.DeviceStatus}" />
                <ui:TextBlock VerticalAlignment="Center"
                              FontTypography="Caption"
                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                              Text="{Binding ViewModel.DeviceStatusText}"
                              TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Command="{Binding ViewModel.GoToStepCommand}" CommandParameter="0"
                       Content="{DynamicResource S.Workbench.Step.Parameters}" />
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="→" />
            <ui:Button Margin="0,0,8,0" Command="{Binding ViewModel.GoToStepCommand}" CommandParameter="1"
                       Content="{DynamicResource S.Workbench.Step.Sequence}" />
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="→" />
            <ui:Button Margin="0,0,8,0" Command="{Binding ViewModel.GoToStepCommand}" CommandParameter="2"
                       Content="{DynamicResource S.Workbench.Step.Source}" />
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="→" />
            <ui:Button Command="{Binding ViewModel.GoToStepCommand}" CommandParameter="3"
                       Content="{DynamicResource S.Workbench.Step.Deployment}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="0,0,0,6"
                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                   Text="{DynamicResource S.Workbench.StepHint}" />

        <Grid Grid.Row="3">
            <Grid Visibility="{Binding ViewModel.IsStepParameters, Converter={StaticResource BoolVis}}">
                <steps:ParameterStepView DataContext="{Binding ViewModel.Parameters}" />
            </Grid>
            <Grid Visibility="{Binding ViewModel.IsStepSequence, Converter={StaticResource BoolVis}}">
                <steps:SequenceStepView DataContext="{Binding ViewModel.Sequence}" />
            </Grid>
            <Grid Visibility="{Binding ViewModel.IsStepSource, Converter={StaticResource BoolVis}}">
                <steps:SourceStepView DataContext="{Binding ViewModel.Source}" />
            </Grid>
            <Grid Visibility="{Binding ViewModel.IsStepDeployment, Converter={StaticResource BoolVis}}">
                <steps:DeploymentStepView DataContext="{Binding ViewModel.Deployment}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
