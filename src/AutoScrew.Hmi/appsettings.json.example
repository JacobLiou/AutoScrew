{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "logs/autoscrew-.log", "rollingInterval": "Day" } }
    ]
  },
  "AutoScrew": {
    "UseMockMes": true,
    "UseSimulatedHardware": true,
    "MesBaseUrl": "https://localhost/",
    "DataDirectory": "",
    "TemplateDirectory": "Templates",
    "StationId": "STATION-01",
    "UiCulture": "zh-CN",
    "AuditLogEnabled": true,
    "AuditDirectory": ""
  },
  "IemdSd": {
    "_comment": "Legacy seed for first-run migration to DataDirectory/stations/{StationId}/devices.json. Device connection is managed in HMI.",
    "Enabled": false,
    "Host": "192.168.1.11",
    "Port": 502,
    "ToolIndex": 0,
    "TriggerMode": "AutoDi",
    "AutoLockOnInit": false,
    "SendUnlockAfterCycle": true,
    "UseLegacyFinishRegister": false,
    "CommandTimeoutMs": 3000,
    "ParameterIdByPosition": {
      "1": 1,
      "2": 2
    }
  },
  "Authentication": {
    "Mode": "MimsMySql",
    "Mims": {
      "ConnectionString": "",
      "ConnectionStringDpapiBase64": "aes256:用 tools/EncryptMimsConnectionString 生成，见 doc/CONNECTION_STRING_ENCRYPTION.md",
      "DpapiScope": "LocalMachine",
      "CommandTimeoutSeconds": 15
    }
  }
}
