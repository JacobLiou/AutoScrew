<Window x:Class="AutoScrew.Hmi.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
        mc:Ignorable="d"
        Title="AutoScrew 自动取螺钉系统"
        Height="380"
        Width="520"
        MinHeight="380"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="Transparent"
        d:DataContext="{d:DesignInstance vm:LoginViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <SolidColorBrush x:Key="LoginFieldBg"
                         Color="#33FFFFFF" />
        <SolidColorBrush x:Key="LoginOverlayBrush"
                         Color="#C10D1B2A" />
        <SolidColorBrush x:Key="LoginLinkBrush"
                         Color="#B3E3F2FF" />
        <FontFamily x:Key="Mdl2">Segoe MDL2 Assets</FontFamily>
        <Style x:Key="LoginPillFieldBorder"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource LoginFieldBg}" />
            <Setter Property="CornerRadius"
                    Value="19" />
            <Setter Property="Padding"
                    Value="4,2" />
            <Setter Property="MinHeight"
                    Value="38" />
            <Setter Property="SnapsToDevicePixels"
                    Value="True" />
        </Style>
        <Style x:Key="LoginIconGlyph"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{StaticResource Mdl2}" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="Foreground"
                    Value="#E6FFFFFF" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="16,0,8,0" />
        </Style>
        <Style x:Key="LoginInnerTextBox"
               TargetType="hc:TextBox"
               BasedOn="{StaticResource TextBoxExtend}">
            <Setter Property="hc:BorderElement.CornerRadius"
                    Value="0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="#F2FFFFFF" />
            <Setter Property="CaretBrush"
                    Value="White" />
            <Setter Property="hc:InfoElement.ShowClearButton"
                    Value="False" />
        </Style>
        <Style x:Key="LoginInnerPasswordBox"
               TargetType="hc:PasswordBox"
               BasedOn="{StaticResource PasswordBoxExtend}">
            <Setter Property="hc:BorderElement.CornerRadius"
                    Value="0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="#F2FFFFFF" />
            <Setter Property="CaretBrush"
                    Value="White" />
        </Style>
        <Style x:Key="LoginLinkButton"
               TargetType="Button"
               BasedOn="{StaticResource ButtonCustom}">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="{StaticResource LoginLinkBrush}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Padding"
                    Value="4,6" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="hc:BorderElement.CornerRadius"
                    Value="4" />
        </Style>
        <Style x:Key="LoginLinkButtonRight"
               TargetType="Button"
               BasedOn="{StaticResource LoginLinkButton}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Right" />
        </Style>
    </Window.Resources>
    <Border CornerRadius="0"
            Background="#FF0A1620">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 背景图 + 冷色遮罩 -->
            <Grid Grid.Row="0">
                <Image Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="pack://application:,,,/Assets/login-bg.png" />
                <Border Background="{StaticResource LoginOverlayBrush}"
                         />
            </Grid>
            <!-- 居中登录区 -->
            <Border VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="400"
                    Width="307">
                <StackPanel>
                    <Image Stretch="Fill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="pack://application:,,,/Assets/logo_new.png"
                           Height="38"
                           Width="128"/>
                    <TextBlock Text="AutoScrew"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#99FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,32" />
                    <!-- 用户名 -->
                    <Border Style="{StaticResource LoginPillFieldBorder}"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource LoginIconGlyph}"
                                       Text="&#xE77B;" />
                            <hc:TextBox Grid.Column="1"
                                        Style="{StaticResource LoginInnerTextBox}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        hc:InfoElement.Placeholder="用户名"
                                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                    <!-- 密码 -->
                    <Border Style="{StaticResource LoginPillFieldBorder}"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource LoginIconGlyph}"
                                       Text="&#xE72E;" />
                            <hc:PasswordBox x:Name="PasswordField"
                                            Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#F2FFFFFF"
                                            CaretBrush="White"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            hc:InfoElement.Placeholder="密码" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFFF8A80"
                               TextWrapping="Wrap"
                               MinHeight="22"
                               Margin="4,0,4,10" />
                    <Button Content="登录"
                            Height="38"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsDefault="True"
                            hc:BorderElement.CornerRadius="19"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            Width="303" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0 20 0 0">
                            <CheckBox Content="记住密码"
                                      IsChecked="{Binding RememberMe, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Foreground="#CCFFFFFF"
                                      FontSize="13" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="忘记密码"
                                Margin="0 20 0 0"
                                Style="{StaticResource LoginLinkButtonRight}"
                                Command="{Binding OpenForgotPasswordCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
