<ui:FluentWindow x:Class="AutoScrew.Hmi.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:AutoScrew.Hmi.ViewModels"
                 xmlns:controls="clr-namespace:AutoScrew.Hmi.Controls"
                 mc:Ignorable="d"
                 Title="{Binding WindowTitle}"
                 Height="380"
                 Width="520"
                 MinHeight="380"
                 MinWidth="520"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ShowInTaskbar="True"
                 WindowBackdropType="None"
                 Background="Transparent"
                 d:DataContext="{d:DesignInstance vm:LoginViewModel, IsDesignTimeCreatable=False}">
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="LoginFieldBg"
                         Color="#33FFFFFF" />
        <SolidColorBrush x:Key="LoginOverlayBrush"
                         Color="#410D1B2A" />
        <SolidColorBrush x:Key="LoginLinkBrush"
                         Color="#B3E3F2FF" />
        <FontFamily x:Key="Mdl2">Segoe MDL2 Assets</FontFamily>
        <Style x:Key="LoginPillFieldBorder"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource LoginFieldBg}" />
            <Setter Property="CornerRadius"
                    Value="19" />
            <Setter Property="Padding"
                    Value="4,2" />
            <Setter Property="MinHeight"
                    Value="38" />
        </Style>
        <Style x:Key="LoginIconGlyph"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{StaticResource Mdl2}" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="Foreground"
                    Value="#E6FFFFFF" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="16,0,8,0" />
        </Style>
        <Style x:Key="LoginInnerTextBox"
               TargetType="ui:TextBox">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="#F2FFFFFF" />
            <Setter Property="CaretBrush"
                    Value="White" />
            <Setter Property="PlaceholderText"
                    Value="{DynamicResource S.Login.UserName}" />
        </Style>
        <Style x:Key="LoginInnerPasswordBox"
               TargetType="ui:PasswordBox">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="#F2FFFFFF" />
            <Setter Property="CaretBrush"
                    Value="White" />
            <Setter Property="PlaceholderText"
                    Value="{DynamicResource S.Login.Password}" />
        </Style>
        <Style x:Key="LoginLinkButton"
               TargetType="ui:Button">
            <Setter Property="Appearance"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{StaticResource LoginLinkBrush}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Padding"
                    Value="4,6" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
        </Style>
        <Style x:Key="LoginLinkButtonRight"
               TargetType="ui:Button"
               BasedOn="{StaticResource LoginLinkButton}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Right" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
        </Style>
        <Style x:Key="LoginCultureComboStyle"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="MinWidth"
                    Value="132" />
            <Setter Property="Padding"
                    Value="10,6" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Background"
                    Value="#44FFFFFF" />
            <Setter Property="Foreground"
                    Value="#F2FFFFFF" />
            <Setter Property="BorderBrush"
                    Value="#66FFFFFF" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Cursor"
                    Value="Hand" />
        </Style>
    </ui:FluentWindow.Resources>
    <Border CornerRadius="0"
            Background="#FF0A1620">
        <Grid>
            <!--<controls:CultureSelector VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,40,0"
                                    Panel.ZIndex="10"
                                    Variant="Login"
                                    CultureOptions="{Binding CultureOptions}"
                                    SelectedCulture="{Binding SelectedCulture, Mode=TwoWay}" />-->
            <Button Command="{Binding CancelCommand}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Width="32"
                    Height="32"
                    Margin="0,8,8,0"
                    Panel.ZIndex="10"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="{DynamicResource S.Common.Close}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg"
                                     Fill="Transparent" />
                            <Viewbox Width="14"
                                     Height="14">
                                <Canvas Width="10"
                                        Height="10">
                                    <Line X1="0" Y1="0" X2="10" Y2="10"
                                          Stroke="#CCFFFFFF"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Line X1="10" Y1="0" X2="0" Y2="10"
                                          Stroke="#CCFFFFFF"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#44FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Grid>
                <Image Stretch="UniformToFill"
                       Source="pack://application:,,,/Assets/login-bg.png" />
                <Border Background="{StaticResource LoginOverlayBrush}" />
            </Grid>
            <Border VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="400"
                    Width="307">
                <StackPanel>
                    <Image Source="pack://application:,,,/Assets/logo_new.png"
                           Height="38"
                           Width="128"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="AutoScrew"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#99FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,32" />
                    <Border Style="{StaticResource LoginPillFieldBorder}"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource LoginIconGlyph}"
                                       Text="&#xE77B;" />
                            <ui:TextBox Grid.Column="1"
                                        Style="{StaticResource LoginInnerTextBox}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource LoginPillFieldBorder}"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource LoginIconGlyph}"
                                       Text="&#xE72E;" />
                            <ui:PasswordBox x:Name="PasswordField"
                                            Grid.Column="1"
                                            Style="{StaticResource LoginInnerPasswordBox}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFFF8A80"
                               TextWrapping="Wrap"
                               MinHeight="22"
                               Margin="4,0,4,10" />
                    <ui:Button Content="{DynamicResource S.Login.SignIn}"
                               Height="38"
                               FontSize="13"
                               FontWeight="SemiBold"
                               IsDefault="True"
                               Appearance="Primary"
                               Command="{Binding LoginCommand}"
                               Width="303" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Content="{DynamicResource S.Login.RememberMe}"
                                  IsChecked="{Binding RememberMe, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Foreground="#CCFFFFFF"
                                  FontSize="13"
                                  Margin="0,20,0,0" />
                        <!--<ui:Button Grid.Column="1"
                                   Content="忘记密码"
                                   Margin="0,20,0,0"
                                   Style="{StaticResource LoginLinkButtonRight}"
                                   Command="{Binding OpenForgotPasswordCommand}"
                                   ui:ShadowAssist.ShadowDepth="0" />-->
                        <TextBlock  Grid.Column="1"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Hyperlink Command="{Binding OpenForgotPasswordCommand}">
                                <Run Text="{Binding ForgotPasswordLabel, Mode=OneWay}" />
                            </Hyperlink></TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
